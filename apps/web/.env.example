# ProjectOne web — environment template
#
# Copy to `.env.local` and fill in. `.env*` files are git-ignored and must never
# be committed (CLAUDE.md §16, §28a). Every value below is a PLACEHOLDER — this
# file is committed, so a real credential here would be a credential leak.
#
# WARNING: variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle
# at build time and are readable by anyone using the site. Only ever put
# non-secret values behind that prefix. A secret the browser genuinely needs is
# a design error — it belongs behind an API route, not in the bundle
# (CLAUDE.md §35).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Which environment this instance is running in.
# One of: development | staging | production
NEXT_PUBLIC_PROJECTONE_ENVIRONMENT=development

# Base URL of the ProjectOne API (apps/api). Absolute URL, no trailing slash.
NEXT_PUBLIC_PROJECTONE_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# No variable here, but a deployment requirement worth knowing (ADR-002)
# ---------------------------------------------------------------------------
#
# This server forwards the browser's address to the API on public auth calls,
# so the API can rate limit per client rather than per proxy. It reads that
# address from the platform's own headers (x-real-ip, x-forwarded-for) and
# needs no configuration of its own.
#
# THE API MUST BE CONFIGURED TO TRUST THIS SERVER. Add this server's address to
# PROJECTONE_TRUSTED_PROXIES in apps/api/.env, or the forwarded address is
# ignored and every user shares one rate-limit bucket — ten sign-in attempts
# then lock out the whole platform.

# ---------------------------------------------------------------------------
# Not yet used — added by later steps, listed so the shape is predictable
# ---------------------------------------------------------------------------
# Supabase public keys arrive with STEP-07. Server-only secrets (service-role
# keys, AI provider keys) must NOT use the NEXT_PUBLIC_ prefix and belong in
# apps/api, not here.
