# ProjectOne API — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed
# (CLAUDE.md §16, §28a). Every value below is a PLACEHOLDER — this file is
# committed, so a real credential here would be a credential leak.
#
# Variables are prefixed PROJECTONE_ and read at startup. A missing required
# variable stops the process with a message naming it.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Which environment this instance is running in.
# One of: development | staging | production
# No default on purpose — a production deploy that forgets this must fail
# loudly rather than start in the wrong mode.
PROJECTONE_ENVIRONMENT=development

# Supabase project URL. Found in the Supabase dashboard under Project Settings
# → API. Not a secret, but required.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret (service-role) key. SERVER-SIDE ONLY.
#
# This key BYPASSES ROW LEVEL SECURITY entirely — it can read and write every
# row in every table regardless of policy. It must never reach apps/web, never
# carry a NEXT_PUBLIC_ prefix, and never appear in a log, a transcript or a
# commit. If it is ever exposed, rotate it in the Supabase dashboard
# immediately (CLAUDE.md §16).
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# PRIVILEGED connection string — Alembic migrations ONLY.
#
# Connects as `postgres`, which carries rolbypassrls: PostgreSQL skips every RLS
# policy for it. That is correct for migrations, which must create tables and
# policies, and catastrophic for serving requests — a tenant query over this
# connection reads every workspace's rows, silently, while every isolation test
# still passes. Nothing on the request path may use it (CLAUDE.md §16).
#
# SESSION POOLER, PORT 5432 — not the direct `db.<ref>.supabase.co` host.
# Supabase serves direct connections over IPv6 only (an IPv4 add-on is paid),
# and an IPv4-only network cannot reach them at all. The session pooler is
# IPv4-reachable on every tier. Two details are mandatory:
#
#   - USERNAME IS `<role>.<project-ref>`. A bare username is rejected.
#   - PORT 5432 (session mode), NEVER 6543 (transaction mode). Transaction
#     mode does not support prepared statements, which psycopg uses.
#
# Find your region in the dashboard → Project Settings → Database →
# Connection string → Session pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# REQUEST-PATH connection string — every API request.
#
# Connects as `projectone_api`, created by migration `d7b95c1f4e08`. Two of its
# properties matter: it does NOT carry rolbypassrls, so the RLS policies
# actually apply to it; and it is NOINHERIT, so it holds none of
# `authenticated`'s privileges until the API explicitly SET ROLEs per
# transaction. A missing SET ROLE therefore fails closed rather than open.
#
# DO NOT SET THE PASSWORD BY HAND. The migration deliberately creates the role
# without one (a credential in a migration is a credential in source control),
# which historically meant setting it manually in the SQL editor and pasting it
# here — two independent writes with nothing linking them. That divergence is
# undetectable until the first request that touches a tenant table, and it cost
# two sessions on 2026-08-03. Instead run:
#
#   python scripts/sync-request-role-credential.py
#
# It generates the password, applies it to the role, PROVES it by connecting as
# that role, and only then rewrites this line. No human sees or types the value.
# `--check` verifies the two still agree without changing anything.
#
# Same pooler rules as DATABASE_URL: `<role>.<project-ref>`, port 5432.
#
# Deliberately has no fallback to DATABASE_URL. Defaulting to the privileged
# connection would turn a forgotten variable into total, invisible loss of
# tenant isolation — so the API refuses to start instead.
REQUEST_DATABASE_URL=postgresql://projectone_api.your-project-ref:generated-by-the-sync-script@aws-0-your-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Trusted proxies — rate limiting behind a reverse proxy (ADR-002)
# ---------------------------------------------------------------------------

# Peers permitted to set forwarding headers. Comma-separated CIDR ranges or
# bare IP addresses.
#
# WHY THIS EXISTS: every browser call reaches the API through the Next.js
# proxy, so the peer address the API sees is the proxy's, not the client's.
# Without this setting, every user on the platform shares one rate-limit
# bucket and ten requests lock everyone out of sign-in.
#
# WHY IT IS NOT JUST "TRUST X-FORWARDED-FOR": that header is caller-supplied.
# Honouring it unconditionally hands the limiter's key to the attacker — vary
# one header value, get an unlimited allowance, while the logs show a limiter
# working normally. It is honoured ONLY from a peer listed here.
#
# EMPTY MEANS TRUST NOTHING. Limiting then falls back to the peer address:
# weaker, but never forgeable. There is no value that disables limiting.
#
# WHAT TO PUT HERE: every proxy between the internet and this API.
#   - Local development, web and API on one host:   127.0.0.1,::1
#   - Next.js on a private network:                 10.0.0.0/8
#   - Behind Cloudflare: Cloudflare's published ranges PLUS your own proxy.
#     https://www.cloudflare.com/ips/  (they change — re-check on deploy)
#
# DEPLOYMENT REQUIREMENT: any proxy listed here MUST strip or overwrite an
# inbound X-Forwarded-For from the internet rather than appending to it. A
# trusted proxy that blindly appends passes attacker-supplied entries into a
# chain this API is about to trust.
PROJECTONE_TRUSTED_PROXIES=127.0.0.1,::1

# Optional single-hop header a platform overwrites on every request, preferred
# over X-Forwarded-For when set. Honoured only from a peer already trusted
# above — such a header is trustworthy solely BECAUSE the platform rewrites it,
# which holds only if the request actually came from that platform.
#
# Cloudflare: CF-Connecting-IP     Empty means use X-Forwarded-For only.
# PROJECTONE_CLIENT_ADDRESS_HEADER=

# ---------------------------------------------------------------------------
# BYOK credential encryption (STEP-17)
# ---------------------------------------------------------------------------

# The AES-256 key that workspace AI provider keys are encrypted with at rest.
# Base64-encoded 32 bytes (44 characters).
#
# Generate one with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#
# REQUIRED. There is deliberately no default: a default would be a hardcoded
# encryption key shared by every deployment, which is not encryption. The API
# refuses to start without a valid one rather than storing provider keys in
# plaintext (CLAUDE.md §16).
#
# PER ENVIRONMENT. Development, staging and production each get their own —
# never shared, never committed (CLAUDE.md §28a). This value is a secret in the
# same class as DATABASE_URL.
#
# ROTATION IS NOT YET SUPPORTED. Changing this makes every stored provider
# credential undecryptable, and each workspace must re-enter its keys. A
# re-encryption path is not built; see STEP-17's known limitations.
PROJECTONE_BYOK_ENCRYPTION_KEY=generate_your_own_do_not_use_this_placeholder=

# ---------------------------------------------------------------------------
# Optional — defaults live in app/core/config.py
# ---------------------------------------------------------------------------

# PROJECTONE_APP_NAME=ProjectOne API
# PROJECTONE_VERSION=0.1.0

# Per-attempt timeout for one AI provider call, in seconds. Generous relative to
# the other timeouts because generation genuinely is slow — a completion is not
# a health check — but still bounded so one hanging upstream call cannot hold a
# worker open indefinitely.
# PROJECTONE_AI_PROVIDER_TIMEOUT_SECONDS=30.0

# ---------------------------------------------------------------------------
# Not yet used — added by later steps, listed so the shape is predictable
# ---------------------------------------------------------------------------
# Workspace AI provider keys are NOT environment variables. They are BYOK: each
# workspace stores its own, encrypted, in `provider_credentials` (STEP-17). The
# only AI-related secret in this file is the encryption key above.
