# ProjectOne API — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed
# (CLAUDE.md §16, §28a). Every value below is a PLACEHOLDER — this file is
# committed, so a real credential here would be a credential leak.
#
# Variables are prefixed PROJECTONE_ and read at startup. A missing required
# variable stops the process with a message naming it.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Which environment this instance is running in.
# One of: development | staging | production
# No default on purpose — a production deploy that forgets this must fail
# loudly rather than start in the wrong mode.
PROJECTONE_ENVIRONMENT=development

# Supabase project URL. Found in the Supabase dashboard under Project Settings
# → API. Not a secret, but required.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret (service-role) key. SERVER-SIDE ONLY.
#
# This key BYPASSES ROW LEVEL SECURITY entirely — it can read and write every
# row in every table regardless of policy. It must never reach apps/web, never
# carry a NEXT_PUBLIC_ prefix, and never appear in a log, a transcript or a
# commit. If it is ever exposed, rotate it in the Supabase dashboard
# immediately (CLAUDE.md §16).
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# PostgreSQL connection string used by the API and by Alembic migrations.
# Supabase dashboard → Project Settings → Database → Connection string.
# Contains the database password, so the same handling rules apply.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Optional — defaults live in app/core/config.py
# ---------------------------------------------------------------------------

# PROJECTONE_APP_NAME=ProjectOne API
# PROJECTONE_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Not yet used — added by later steps, listed so the shape is predictable
# ---------------------------------------------------------------------------
# AI provider keys arrive with STEP-17 (AI Router). Each environment gets its
# own keys — never shared across dev/staging/production (CLAUDE.md §28a).
