# ---------------------------------------------------------------------------
# Environment & secrets
# Secrets are never committed, never hardcoded, never logged (CLAUDE.md §16, §28a).
# Ignored from the first commit — a secret committed once is committed forever.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.yarn/install-state.gz

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Test & coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Editor & tooling
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---------------------------------------------------------------------------
# OS artifacts
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Obsidian
# The vault itself is tracked (it is the source of truth); only per-machine
# workspace state is not.
# ---------------------------------------------------------------------------
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
